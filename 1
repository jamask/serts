function getHostname(ip) {
    return new Promise((resolve, reject) => {
        exec(nslookup ${ip}, (error, stdout, stderr) => {
            if (error) {
                reject(Error: ${stderr});
            } else {
                const matches = stdout.match(/name = (.*)\./);
                const hostname = matches ? matches[1] : 'Unknown';
                resolve(hostname);
            }
        });
    });
}

